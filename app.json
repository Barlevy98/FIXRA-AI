{
  "expo": {
    "name": "FIXRA AI",
    "slug": "fixra-ai",
    "version": "1.1",
    "scheme": "fixra",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050012"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixra.app",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050012"
      },
      "package": "com.fixra.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FIXRA AI to access your photos so you can upload gameplay screenshots for AI analysis.",
          "cameraPermission": "Allow FIXRA AI to use your camera so you can take pictures of your screen for AI gameplay analysis.",
          "microphonePermission": "Allow FIXRA AI to access your microphone for recording video gameplay."
        }
      ],
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-9244809721385064~2996235590"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b144f10c-d747-4759-9922-6541cdcfa7ba"
      }
    }
  }
}